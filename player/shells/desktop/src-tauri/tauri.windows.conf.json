{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["nsis"],
    "fileAssociations": [
      {
        "ext": ["m3u8", "m3u"],
        "name": "ScrobbPlayer.M3U",
        "description": "Плейлист M3U"
      },
      {
        "ext": ["pls"],
        "name": "ScrobbPlayer.PLS",
        "description": "Плейлист PLS"
      },
      {
        "ext": ["xspf"],
        "name": "ScrobbPlayer.XSPF",
        "description": "Плейлист XSPF"
      },
      {
        "ext": ["jspf"],
        "name": "ScrobbPlayer.JSPF",
        "description": "Плейлист JSPF"
      }
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false,
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
